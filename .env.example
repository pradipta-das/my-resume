# Copy to .env.local and fill in. Never commit real values.

# WordPress REST API base (already used for the blog).
WORDPRESS_API_URL=https://www.logicncolor.com/wp-json

# Key the site sends with every WordPress API request. Must match
# PRADIPTA_API_SECRET in wp-config.php (see wordpress/pradipta-rest-lock).
# Generate one with: openssl rand -hex 32
WORDPRESS_API_SECRET=

# Claude API key for the cost estimator (https://platform.claude.com).
ANTHROPIC_API_KEY=

# Shared secret for saving estimates to WordPress. Must match
# PRADIPTA_ESTIMATE_SECRET in the WordPress site's wp-config.php.
# Generate one with: openssl rand -hex 32
WORDPRESS_ESTIMATE_SECRET=

# Email: the site sends the estimate copies, consultation acknowledgements and
# new-request notifications itself, from this Titan mailbox. Use the
# mailbox's own password (Titan admin panel), never commit it.
SMTP_USER=hello@pradipta.online
SMTP_PASSWORD=
# Titan's defaults; change only for another provider.
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# Where new-request notifications go (default: SMTP_USER).
# MAIL_NOTIFY_TO=
