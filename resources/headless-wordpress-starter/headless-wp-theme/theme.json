{
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
                    "name": "System Font",
                    "slug": "system-font"
                },
                {
                    "fontFamily": "Georgia, serif",
                    "name": "Georgia",
                    "slug": "georgia"
                }
            ],
            "fontSizes": [
                {
                    "size": "14px",
                    "slug": "small",
                    "name": "Small"
                },
                {
                    "size": "16px",
                    "slug": "medium",
                    "name": "Medium"
                },
                {
                    "size": "20px",
                    "slug": "large",
                    "name": "Large"
                },
                {
                    "size": "24px",
                    "slug": "x-large",
                    "name": "Extra Large"
                },
                {
                    "size": "32px",
                    "slug": "xx-large",
                    "name": "Extra Extra Large"
                }
            ],
            "fontWeight": true,
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "letterSpacing": true
        },
        "color": {
            "background": true,
            "custom": false,
            "customDuotone": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "duotone": [],
            "gradients": [
                {
                    "gradient": "linear-gradient(135deg, #007cba 0%, #005a87 100%)",
                    "name": "Primary Gradient",
                    "slug": "primary-gradient"
                },
                {
                    "gradient": "linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%)",
                    "name": "Light Gradient",
                    "slug": "light-gradient"
                }
            ],
            "link": true,
            "palette": [
                {
                    "color": "#007cba",
                    "name": "Primary",
                    "slug": "primary"
                },
                {
                    "color": "#005a87",
                    "name": "Primary Dark",
                    "slug": "primary-dark"
                },
                {
                    "color": "#666666",
                    "name": "Secondary",
                    "slug": "secondary"
                },
                {
                    "color": "#333333",
                    "name": "Dark",
                    "slug": "dark"
                },
                {
                    "color": "#f8f9fa",
                    "name": "Light",
                    "slug": "light"
                },
                {
                    "color": "#ffffff",
                    "name": "White",
                    "slug": "white"
                },
                {
                    "color": "#000000",
                    "name": "Black",
                    "slug": "black"
                }
            ],
            "text": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "blocks": {
            "core/button": {
                "color": {
                    "background": true,
                    "text": true
                },
                "typography": {
                    "fontSize": true,
                    "lineHeight": true
                },
                "spacing": {
                    "padding": true,
                    "margin": true
                }
            },
            "core/heading": {
                "color": {
                    "background": true,
                    "text": true
                },
                "typography": {
                    "fontSize": true,
                    "fontWeight": true,
                    "lineHeight": true,
                    "textTransform": true
                }
            },
            "core/paragraph": {
                "color": {
                    "background": true,
                    "text": true
                },
                "typography": {
                    "fontSize": true,
                    "lineHeight": true
                }
            },
            "core/image": {
                "spacing": {
                    "margin": true,
                    "padding": true
                }
            },
            "core/group": {
                "color": {
                    "background": true,
                    "text": true
                },
                "spacing": {
                    "margin": true,
                    "padding": true
                }
            },
            "core/columns": {
                "spacing": {
                    "margin": true,
                    "padding": true
                }
            },
            "core/column": {
                "spacing": {
                    "margin": true,
                    "padding": true
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "#ffffff",
            "text": "#333333"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-font)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "2rem"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "#007cba"
                },
                ":hover": {
                    "color": {
                        "text": "#005a87"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontWeight": "600",
                    "lineHeight": "1.3"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "lineHeight": "1.4"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "600",
                    "lineHeight": "1.5"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "600",
                    "lineHeight": "1.6"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "600",
                    "lineHeight": "1.6"
                }
            },
            "button": {
                "color": {
                    "background": "#007cba",
                    "text": "#ffffff"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "500"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "right": "1.5rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem"
                    }
                },
                "border": {
                    "radius": "4px"
                },
                ":hover": {
                    "color": {
                        "background": "#005a87"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--white)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "fontWeight": "500"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "right": "1.5rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem"
                    }
                },
                "border": {
                    "radius": "4px"
                }
            },
            "core/heading": {
                "color": {
                    "text": "var(--wp--preset--color--dark)"
                },
                "spacing": {
                    "margin": {
                        "bottom": "1rem"
                    }
                }
            },
            "core/paragraph": {
                "spacing": {
                    "margin": {
                        "bottom": "1rem"
                    }
                }
            },
            "core/image": {
                "spacing": {
                    "margin": {
                        "bottom": "1rem"
                    }
                }
            },
            "core/group": {
                "spacing": {
                    "padding": {
                        "top": "2rem",
                        "right": "2rem",
                        "bottom": "2rem",
                        "left": "2rem"
                    }
                }
            },
            "core/columns": {
                "spacing": {
                    "margin": {
                        "bottom": "2rem"
                    }
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank",
            "postTypes": [
                "page",
                "post"
            ]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}