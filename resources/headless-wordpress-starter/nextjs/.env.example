# Your WordPress site's address (no trailing slash).
WORDPRESS_URL=https://cms.example.com

# This site's own public address, for canonical URLs, the sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Shared with the WordPress theme (HEADLESS_REVALIDATE_SECRET in wp-config.php),
# so only WordPress can tell this site to refresh. Any long random string.
REVALIDATE_SECRET=

# Optional: only if WordPress runs the REST API Lock plugin, which closes the
# API to anyone without this key (PRADIPTA_API_SECRET in wp-config.php).
WORDPRESS_API_KEY=
